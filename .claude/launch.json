{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "-C",
        "server",
        "run",
        ".",
        "-env",
        "../../shh/spotify.env,../../shh/apple.env,dev.env"
      ],
      "port": 8080,
      "url": "http://127.0.0.1:8080"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "web-https",
      "runtimeExecutable": "web/node_modules/.bin/vite",
      "runtimeArgs": [
        "--config",
        "web/vite.https.config.ts"
      ],
      "port": 5174,
      "url": "https://localhost:5174"
    }
  ]
}
